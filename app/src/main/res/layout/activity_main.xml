<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sahayak"
            android:textColor="#1D2433"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="You speak, Sahayak does the rest"
            android:textColor="#667085"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/assistButton"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:backgroundTint="#1F5C4D"
                android:text="Assist"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#1D2433"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Setup"
                android:textColor="#1D2433"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/controlButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:textAllCaps="false"
                android:textSize="17sp" />

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:textAllCaps="false"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheduled tasks"
                android:textColor="#1D2433"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No tasks yet. Tell Sahayak: Send a WhatsApp message on 5 Nov at 12 PM."
                android:textColor="#667085"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/workBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Label"
                android:text="Video queue for YouTube" />

            <EditText
                android:id="@+id/videoGap"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Hours between videos (default 6)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textSize="16sp" />

            <Button
                android:id="@+id/addVideosButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Add videos"
                android:textAllCaps="false"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ratingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rate recent tasks"
                android:textColor="#1D2433"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ratingBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Taught tasks"
                android:textColor="#1D2433"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/teachButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:text="Teach a new task"
                android:textAllCaps="false"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/skillBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/backupButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Back up taught tasks"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Button
                android:id="@+id/restoreButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Restore from backup"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView style="@style/Label" android:text="Language: English" />

            <RadioGroup
                android:id="@+id/languageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/langHindi"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Hindi"
                    android:textSize="17sp" />

                <RadioButton
                    android:id="@+id/langMarathi"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:text="Marathi"
                    android:textSize="17sp" />
            </RadioGroup>

            <TextView style="@style/Label" android:text="Voice" />

            <RadioGroup
                android:id="@+id/voiceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/voiceFemale"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Female: warm"
                    android:textSize="17sp" />
                <RadioButton
                    android:id="@+id/voiceSoft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Female: soft"
                    android:textSize="17sp" />
                <RadioButton
                    android:id="@+id/voiceMale"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Male: smart"
                    android:textSize="17sp" />
                <RadioButton
                    android:id="@+id/voiceDeep"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Male: deep"
                    android:textSize="17sp" />
            </RadioGroup>

            <TextView style="@style/Label" android:text="Volume" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100" />

            <TextView style="@style/Label" android:text="Your name" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="For example, Rahul"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="17sp" />

            <CheckBox
                android:id="@+id/autoStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Speak when the screen changes"
                android:textSize="17sp" />

            <TextView style="@style/Label" android:text="Whisper key (Groq)" />

            <EditText
                android:id="@+id/whisperInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Paste here for better recognition"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="17sp" />

            <TextView style="@style/Label" android:text="TaskVox key (AI calls)" />

            <EditText
                android:id="@+id/taskVoxInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Paste here for AI phone calls"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="17sp" />

            <TextView style="@style/Label" android:text="Gemini key" />

            <EditText
                android:id="@+id/keyInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Paste here"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="17sp" />

            <CheckBox
                android:id="@+id/learnBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="Learn my habits daily"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When on, your commands are saved on this phone and sent to Gemini once a day to learn. Long numbers are hidden. Turning this off deletes the daily record."
                android:textColor="#667085"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ratingAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#1F5C4D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/learnSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#1F5C4D"
                android:textSize="15sp" />

            <Button
                android:id="@+id/clearLearning"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Delete all learned data"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <TextView style="@style/Label" android:text="What Sahayak remembers" />

            <LinearLayout
                android:id="@+id/memoryBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/reportButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Copy report"
                android:textAllCaps="false"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/reportText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Test version: your screen and voice go to Google, and people at Google may read free-plan data. Press Stop before typing a password, OTP, PIN or card number."
                android:textColor="#B42318"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
